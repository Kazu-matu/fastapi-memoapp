# 環境設定テンプレート
# このファイルをコピーして .env を作成し、値を環境に合わせて変更してください。
# cp .env.example .env

APP_NAME=メモアプリ
DEBUG=false

# -------------------------------------------------------------------
# DB 設定（どちらか一方のコメントを外して使用）
# -------------------------------------------------------------------

# 開発環境: SQLite（ドライバ: aiosqlite）
DATABASE_URL=sqlite+aiosqlite:///./memodb.sqlite

# 本番環境: PostgreSQL（ドライバ: asyncpg）
# 事前に `uv sync --extra prod` で asyncpg をインストールすること
# DATABASE_URL=postgresql+asyncpg://memoapp_user:password@localhost:5432/memoapp_db
